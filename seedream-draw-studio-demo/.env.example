# 仅支持 volcengine 或 byteplus。每个部署固定选择一个服务。
ARK_PROVIDER=volcengine

# 当前 Provider 对应的 API Key。仅在本地 .env.local 或部署密钥中填写。
ARK_API_KEY=

# 可选。不填写时按 Provider 自动选择官方模型：
# volcengine -> doubao-seedream-5-0-pro-260628
# byteplus  -> dola-seedream-5-0-pro-260628
ARK_MODEL_ID=

# 应用自己的结果图片令牌签名密钥。下面的默认值可直接用于本地调试，无需额外填写。
# 生产部署必须替换成独立随机值（建议使用 openssl rand -hex 32），且不能与 ARK_API_KEY 相同。
RESULT_IMAGE_SIGNING_SECRET=local-dev-result-signing-secret-change-in-production

# 可选。方舟请求超时，范围 1000–300000 毫秒，默认 180000。
ARK_TIMEOUT_MS=180000
